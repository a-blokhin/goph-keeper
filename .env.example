# GophKeeper Server Environment Variables
# Copy this file to .env and update the values with your own secure keys

# Database connection string
DATABASE_DSN="host=localhost port=5432 user=gophkeeper password=gophkeeper_password dbname=gophkeeper sslmode=disable"

# JWT secret key - generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key-here"

# 32-byte encryption key for AES-GCM - generate with: openssl rand -base64 32 | tr -d '=' | cut -c1-32
ENCRYPTION_KEY="your-32-byte-encryption-key-here"

# Server address
SERVER_ADDRESS=":50051"

# TLS configuration (optional)
ENABLE_TLS="false"
TLS_CERT=""
TLS_KEY=""
